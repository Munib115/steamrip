# Database
DATABASE_URL=sqlite+aiosqlite:///./games.db
# Or set an explicit absolute path:
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/backend/games.db

# CORS (comma-separated origins; "*" allows all)
CORS_ORIGINS=*

# Scraper (only scrape sites you own or have explicit permission to scrape)
SCRAPE_BASE_URL=http://127.0.0.1:8000/fixtures/
SCRAPE_MAX_PAGES=5
SCRAPE_RATE_LIMIT_DELAY=1.5

# Selectors (XPath) - adjust to match the target site's markup
SCRAPE_CARD_SELECTOR=//article[contains(@class,'game')]
SCRAPE_TITLE_SELECTOR=.//h2/a/text()
SCRAPE_DETAIL_LINK_SELECTOR=.//h2/a/@href
SCRAPE_THUMB_SELECTOR=.//img/@src
SCRAPE_NEXT_PAGE_SELECTOR=//a[contains(@class,'next')]/@href

SCRAPE_DESC_SELECTOR=//div[contains(@class,'description')]//p//text()
SCRAPE_DOWNLOAD_SELECTOR=//a[contains(@class,'download') or contains(@class,'btn-download')]/@href
SCRAPE_REQ_SELECTOR=//div[contains(@class,'requirements')]//text()

# Scheduler
ENABLE_SCHEDULER=false
SCRAPE_INTERVAL_HOURS=24